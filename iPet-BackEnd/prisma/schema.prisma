generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String?  @unique
  passwordHash String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Profile fields
  displayName  String?
  avatar       String?
  uid          String   @unique @default(uuid())
  mbti         String?
  bio          String?
  tags         String?
  
  // Membership info (flattened or JSON)
  membershipLevel    String?
  membershipExpireAt DateTime?

  syncState    UserSyncState?
  pets         Pet[]
  
  // New fields for Profile & Settings
  isVerified   Boolean  @default(false)
  realName     String?
  idCard       String?
  points       Int      @default(0)
  settings     String?  // JSON string for settings

  // Guest account support
  isGuest        Boolean  @default(false)
  lastActiveAt   DateTime @default(now())
  guestCreatedAt DateTime @default(now())
  guestDeviceId  String?
  guestOrigin    String?

  // Admin management fields
  isBanned     Boolean  @default(false)
  bannedAt     DateTime?
  bannedReason String?
  
  // Soft delete for admin operations
  deletedAt    DateTime?
  deletedBy    String?   // Admin ID who deleted

  @@index([isGuest, lastActiveAt], name: "users_guest_last_active")
  @@index([isBanned], name: "users_is_banned")
  @@index([deletedAt], name: "users_deleted_at")
}

// Admin model for backend management
model Admin {
  id             String   @id @default(cuid())
  username       String   @unique
  email          String?  @unique
  passwordHash   String
  displayName    String?
  role           String   @default("admin")  // admin
  isActive       Boolean  @default(true)
  tokenRevokedAt DateTime?  // Tokens issued before this time are invalid
  lastLoginAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  auditLogs      AdminAuditLog[]
}

// Admin audit log for tracking all admin actions
model AdminAuditLog {
  id          String   @id @default(cuid())
  adminId     String?
  admin       Admin?   @relation(fields: [adminId], references: [id], onDelete: SetNull)
  
  action      String   // login, ban_user, unban_user, delete_user, create_article, update_article, delete_article, etc.
  targetType  String?  // user, article, pet, system
  targetId    String?  // ID of the affected resource
  details     Json?    // Additional details, diff, old/new values
  
  ip          String?
  userAgent   String?
  
  createdAt   DateTime @default(now())

  @@index([adminId, createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
  @@index([targetType, targetId])
}


model UserSyncState {
  id        String   @id @default(cuid())
  userId    String      @unique
  user      User     @relation(fields: [userId], references: [id])
  snapshot  String   // Legacy snapshot, kept for migration
  version   Int      @default(1)
  updatedAt DateTime @updatedAt
}

model Pet {
  id        String   @id // UUID from client
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  
  name      String
  type      String?
  breed     String?
  age       Int?
  weight    Float?
  gender    String?
  avatar    String?
  birthday  String? // YYYY-MM-DD
  arrivalDate String? // YYYY-MM-DD - Date pet arrived home
  
  // New fields
  personality  String? // JSON string
  isSterilized Boolean @default(false)
  chipId       String?
  toys         String?
  allergens    String?
  vaccineDate  String?
  description  String?
  
  updatedAt DateTime @updatedAt
  deleted   Boolean  @default(false)
  version   Int      @default(1)
  
  healthRecords  HealthRecord[]
  pinnedMetrics  PinnedMetric[]
  healthSchedules HealthSchedule[]

  // TD-008: Index for user's active pets query
  @@index([userId, deleted], name: "idx_pet_user_active")
}

model HealthRecord {
  id        String   @id // UUID from client
  petId     String
  pet       Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)
  
  type      String   // weight, heart_rate, etc.
  value     Float
  unit      String
  date      String   // ISO timestamp or YYYY-MM-DD
  notes     String?
  source    String?
  metadata  Json?    // Flexible metadata: { isScheduled, targetDate, selectedOptions, etc. }
  
  updatedAt DateTime @updatedAt
  deleted   Boolean  @default(false)
  version   Int      @default(1)

  // TD-008: Index for date-range queries
  @@index([petId, date(sort: Desc)], name: "idx_health_record_pet_date")
}



model Article {
  id        String   @id @default(cuid())
  title     String
  summary   String
  content   String   // HTML or Markdown
  cover     String?
  category  String   // education, recipe, mythbust
  tags      String[] @default([])
  author    String?
  views     Int      @default(0)
  likes     Int      @default(0)
  sectionPinned   Boolean  @default(false)
  sectionPinnedAt DateTime?
  pinnedMetrics   String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Soft delete for admin operations
  deletedAt DateTime?
  deletedBy String?   // Admin ID who deleted

  // TD-008: Index for category filtering with date ordering
  @@index([category, createdAt(sort: Desc)], name: "idx_article_category_created")
  @@index([deletedAt], name: "idx_article_deleted_at")
}

model ArticleCategory {
  key       String   @id
  label     String
  order     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([order], name: "idx_article_category_order")
}

model PinnedMetric {
  id        String   @id @default(cuid())
  petId     String
  pet       Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)
  metricKey String
  
  createdAt DateTime @default(now())

  @@unique([petId, metricKey])
}

model HealthSchedule {
  id        String   @id @default(cuid())
  petId     String
  pet       Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)
  
  type      String   // Metric key (e.g. 'deworming')
  date      DateTime // Scheduled date
  time      String?  // Optional time HH:mm
  repeat    String?  // Repeat rule (none, month, month_3, etc)
  note      String?
  isActive  Boolean  @default(true)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // TD-008: Index for active schedules per pet
  @@index([petId, isActive, date], name: "idx_health_schedule_pet_active")
}
