# 数据目录路径
IPET_DATA_DIR=""
# PostgreSQL 连接字符串
DATABASE_URL=""
# Redis 连接字符串
REDIS_URL=""
# 缓存默认 TTL（毫秒）
CACHE_DEFAULT_TTL_MS=""
# 缓存命名空间前缀
CACHE_NAMESPACE=""
# 触发冷却前最大登录失败次数
AUTH_LOGIN_MAX_FAILURES=""
# 登录失败统计窗口（毫秒）
AUTH_LOGIN_FAIL_WINDOW_MS=""
# 登录冷却时长（毫秒）
AUTH_LOGIN_COOLDOWN_MS=""
# 验证码有效期（秒）
VERIFICATION_CODE_TTL=""
# 默认发件人邮箱
MAIL_FROM=""
# SMTP 主机
SMTP_HOST=""
# SMTP 端口
SMTP_PORT=""
# SMTP 安全连接标识（true/false）
SMTP_SECURE=""
# SMTP 用户名
SMTP_USER=""
# SMTP 密码
SMTP_PASS=""
# JWT 密钥
JWT_SECRET=""
# CORS 允许的来源（逗号分隔）
CORS_ORIGINS=""
# CORS 是否允许携带凭证（true/false）
CORS_CREDENTIALS=""
# CORS 允许的请求头（逗号分隔）
CORS_ALLOWED_HEADERS=""
# CORS 允许的请求方法（逗号分隔）
CORS_METHODS=""
# CORS 暴露的响应头（逗号分隔）
CORS_EXPOSED_HEADERS=""
# CORS 预检成功状态码
CORS_OPTIONS_SUCCESS_STATUS=""
# CORS 预检是否继续到下一个中间件（true/false）
CORS_PREFLIGHT_CONTINUE=""
# Prisma 慢查询阈值（毫秒）
OBS_PRISMA_SLOW_QUERY_MS=""
# HTTP 指标最大采样数
OBS_HTTP_METRICS_MAX_SAMPLES=""
# 指标 Token
OBS_METRICS_TOKEN=""
