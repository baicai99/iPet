# `.env.development` - 开发环境配置
# - 预览 (微信/uni 预览) 也可以使用此文件
# - Mock 行为由 `VITE_MOCK` 控制

# API 基础 URL（Vite 代理的相对路径，必须以 /api 结尾）
VITE_API_BASE_URL=/api

# 小程序 API 基础 URL（必须是绝对路径，用于本地/远程开发）
# VITE_API_BASE_URL_MP=http://localhost:3000/api
VITE_API_BASE_URL_MP=https://api.zhengjiyuan.top/api


# 代理目标：Vite 开发服务器转发 /api 请求的目标地址
# - http://localhost:3000 本地后端（默认）
# - https://api.zhengjiyuan.top 远程后端
# VITE_PROXY_TARGET=http://localhost:3000

# Mock 模式：true = 使用模拟数据，false = 使用真实 API
VITE_MOCK=false

# 身份验证启动策略：guest | login | none
# - guest: 无 token 时自动游客登录（推荐用于开发）
# - login: 无 token 时重定向到登录页
# - none: 无 token 时不进行操作
VITE_AUTH_BOOTSTRAP=login

# 开发环境权限绕过：在 dev 模式下跳过权限检查
# 默认：false（开发环境应像生产环境一样，以进行准确测试）
VITE_DEV_BYPASS_AUTH=false