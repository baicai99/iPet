# `.env.development` - Development environment configuration
# - Preview (微信/uni 预览) may also use this file
# - Mock behavior controlled by `VITE_MOCK`

# API Base URL (relative path for Vite proxy, must end with /api)
VITE_API_BASE_URL=/api

# Mini Program API Base URL (Must be absolute, for local/remote dev)
VITE_API_BASE_URL_MP=http://localhost:3000/api

# Proxy Target: where Vite dev server forwards /api requests
# - http://localhost:3000 for local backend (default)
# - https://api.zhengjiyuan.top for remote backend
# VITE_PROXY_TARGET=http://localhost:3000

# Mock mode: true = use mock data, false = use real API
VITE_MOCK=false

# Auth Bootstrap Strategy: guest | login | none
# - guest: Auto guest login when no token (recommended for dev)
# - login: Redirect to login page when no token
# - none: Do nothing when no token
VITE_AUTH_BOOTSTRAP=guest

# Dev Auth Bypass: Skip permission checks in dev mode
# Default: false (dev should behave like prod for accurate testing)
VITE_DEV_BYPASS_AUTH=false