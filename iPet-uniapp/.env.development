# `.env.development` now serves both development and preview (`mode=development` / `mode=preview`) builds.
# - Preview (微信/uni 预览) reuses this file, so `.env.preview` is no longer needed.
# - Mock behavior still controlled by `VITE_MOCK` (see `docs/dev/mock-mode.md`), and non-mocked routes require a reachable API backend.
# If you run the backend locally, override via `.env.local` (e.g. http://localhost:3000/api)
VITE_API_BASE_URL=https://api.zhengjiyuan.top/api
# Enable this in your personal config to force mock during dev/preview:
VITE_MOCK=true