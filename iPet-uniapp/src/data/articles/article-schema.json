{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://ipet.example.com/schemas/article-v1.json",
    "title": "Article",
    "description": "iPet 文章数据模型 Schema 定义",
    "type": "object",
    "required": [
        "id",
        "title",
        "summary",
        "content",
        "cover",
        "category",
        "author",
        "tags",
        "updateTime",
        "source"
    ],
    "properties": {
        "id": {
            "type": "string",
            "pattern": "^[a-z0-9_-]+$",
            "minLength": 1,
            "maxLength": 50,
            "description": "文章唯一标识，小写字母、数字、下划线、连字符组合"
        },
        "title": {
            "type": "string",
            "minLength": 5,
            "maxLength": 50,
            "description": "文章标题"
        },
        "summary": {
            "type": "string",
            "minLength": 10,
            "maxLength": 100,
            "description": "文章摘要"
        },
        "content": {
            "type": "string",
            "minLength": 10,
            "description": "Markdown 格式的文章正文"
        },
        "cover": {
            "type": "string",
            "pattern": "^/static/images/articles/.+\\.(png|jpg|jpeg|webp)$",
            "description": "封面图片路径，必须在 /static/images/articles/ 目录下"
        },
        "category": {
            "type": "string",
            "enum": [
                "education",
                "news",
                "debunk"
            ],
            "description": "文章分类：education=科普教育, news=资讯动态, debunk=辟谣澄清"
        },
        "author": {
            "type": "string",
            "minLength": 2,
            "maxLength": 30,
            "description": "作者名称"
        },
        "tags": {
            "type": "array",
            "minItems": 1,
            "maxItems": 10,
            "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 20
            },
            "uniqueItems": true,
            "description": "文章标签数组"
        },
        "updateTime": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "description": "最后更新时间，格式 YYYY-MM-DD"
        },
        "source": {
            "type": "string",
            "enum": [
                "local",
                "remote"
            ],
            "description": "文章来源：local=本地打包, remote=远程CDN"
        },
        "metricKey": {
            "type": "string",
            "pattern": "^[a-z_]+$",
            "description": "关联的健康指标 key（可选，如 weight, meal 等）"
        },
        "readingTime": {
            "type": "number",
            "minimum": 0,
            "description": "预估阅读时长（分钟），由构建脚本自动计算"
        },
        "size": {
            "type": "number",
            "minimum": 0,
            "description": "内容大小（字节），构建时自动添加"
        },
        "lastModified": {
            "type": "string",
            "description": "最后修改时间（ISO 8601），构建时自动添加"
        },
        "hash": {
            "type": "string",
            "description": "内容哈希值，构建时自动添加"
        }
    },
    "additionalProperties": true
}