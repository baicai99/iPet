# `.env.production` - Production environment configuration

# API Base URL (absolute URL, must end with /api)
VITE_API_BASE_URL=https://api.zhengjiyuan.top/api

# Mini Program API Base URL (Must be absolute)
VITE_API_BASE_URL_MP=https://api.zhengjiyuan.top/api

# Auth Bootstrap Strategy: login = redirect to login page when no token
VITE_AUTH_BOOTSTRAP=login
